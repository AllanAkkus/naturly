# ─────────────────────────────────────────────────────────────
#  Naturly – miljövariabler för backend (server/index.ts)
#  Kopiera den här filen till ".env" i projektets rotmapp och
#  fyll i din egen nyckel. .env är redan ignorerad av git.
#  Nyckeln läses ENDAST av servern och skickas aldrig till webbläsaren.
# ─────────────────────────────────────────────────────────────

# Din OpenAI API-nyckel (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Modell för AI-läraren. Måste stödja bilder (vision) för uppgiftshjälpen.
OPENAI_MODEL=gpt-4o-mini

# Port för API-servern (Vite-proxyn i utvecklingsläge pekar hit)
PORT=8787

# Max antal AI-anrop per IP-adress och 15-minutersfönster
AI_RATE_LIMIT=60

# Max storlek för uppladdade filer i megabyte
MAX_UPLOAD_MB=8
